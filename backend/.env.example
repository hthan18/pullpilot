PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pullpilot
GITHUB_CLIENT_ID=replace_with_your_github_oauth_client_id
GITHUB_CLIENT_SECRET=replace_with_your_github_oauth_client_secret
JWT_SECRET=replace_with_a_long_random_secret
# Required in production. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
TOKEN_ENCRYPTION_KEY=
# Create at https://platform.openai.com/api-keys. Never commit the real value.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
